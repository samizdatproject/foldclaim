ator) {\n    int constant ROOT_DELAY = 144;   // blocks, about one day\n\n    bytes32 public activeRoot;\n    int public activeEpoch;\n    bytes32 public pendingRoot;\n    int public pendingEpoch;\n\n    function proposeRoot(sig s, bytes32 root, int epoch) {\n        require(checkSig(s, operator));\n        require(epoch > this.activeEpoch, \"epoch must increase\");\n        this.pendingRoot = root;\n        this.pendingEpoch = epoch;\n    }\n\n    function activateRoot() {\n        require(this.pendingEpoch > this.activeEpoch, \"nothing pending\");\n        require(this.age >= ROOT_DELAY, \"root still in its audit window\");\n        this.activeRoot = this.pendingRoot;\n        this.activeEpoch = this.pendingEpoch;\n    }\n}\n","debug":{"bytecode":"","sourceMap":"11::32:1;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;19:4:24:5;;;26::31;;;11:0:32:1;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;::::1;;;;;;;;;;;;;;;;;;;;;;","logs":[],"requires":[],"functionDebug":{"260e94db":{"requires":[{"ip":36,"line":20},{"ip":54,"line":21,"message":"epoch must increase"}],"logs":[],"sourceMap":"19:4:24:5;;;:32:19:44;;;;;;:46::55;;;;;:4:24:5;;;;;;;;;;;;;;;;;;;;20:25:20:26;:28::36;:8::39:1;21:16:21:21:0;;:24::40;;;;;;;;;;;;;;:16:::1;:8::65;22:27:22:31:0;:8::32:1;;;;;;23:28:23:33:0;:8::34:1;;19:4:24:5:0;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;::::1;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"},"7d688155":{"requires":[{"ip":36,"line":27,"message":"nothing pending"},{"ip":38,"line":28,"message":"root still in its audit window"}],"logs":[],"sourceMap":"26:4:31:5;;;;;;27:16:27:33;;;;;;;;;;;;;;;:36::52;;;;;;;;;;;;;;:16:::1;:8::73;12:30:12:33:0;28:8:28:74:1;;29:26:29:42:0;;;;;;;;;;;;;;;30:27:30:44;;;;;;;;;;;;;;;:8::45:1;;26:4:31:5:0;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;::::1;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"}},"invokeDebug":{"2":{"bytecode":"01207f75","name":"compiler helper 2","requires":[],"lo