9c561da7e1920101f44c313a02 OP_DROP","source":"pragma solidcash ^0.51.0;\n\ninterface IRootRegistry {\n    public bytes32 activeRoot;\n    public int activeEpoch;\n    public bytes32 pendingRoot;\n    public int pendingEpoch;\n}\n\n// FoldClaimPool: pull-based reward claims for a CashToken (FoldingCash FLDCH).\n//\n// The pool holds the reward tokens in a token container and pays any leaf of the active Merkle root of\n// (recipient locking bytecode, cumulative earned). Anyone can submit a claim; tokens always go to the\n// leaf's own locking bytecode, so a relayer can claim for a user but never redirect the payout.\n// `claimed` is a verified mapping: one entry NFT per recipient records the cumulative total already paid\n// (the receipt), so a claim pays only the difference and can never be repeated. Roots come from a\n// RootRegistry, where each new root waits out a public audit window before it can be used.\ncontract FoldClaimPool(bytes32 rewardCategory, address registry) {\n    bytes32 root;\n    int epoch;\n\n    mapping(address => bigint) public claimed;\n\n    // Copy the registry's ACTIVE root (never the pending one, which is still in its audit window).\n    // Anyone may call it; reading the registry does not touch its timelocked master.\n    function syncRoot() {\n        int active = IRootRegistry(registry).activeEpoch;\n        require(active > this.epoch, \"already in sync\");\n        this.root = IRootRegistry(registry).activeRoot;\n        this.epoch = active;\n    }\n\n    function claim(bytes32 category, address recipient, bigint cumulative, bytes proof, int index) {\n        require(category == rewardCategory, \"wrong token\");\n        require(index >= 0, \"negative index\");\n        bytes32 node = sha256(0x00 + bytes(recipient) + toPaddedBytes(cumulative, 8));\n        int depth = proof.length / 32;\n        require(proof.length == depth * 32, \"bad proof length\");\n        require(depth <= 24, \"proof too deep\");\n        int position = index;\n        for (int k = 0; k < depth; k++) {\n            bytes32 sibling = bytes32(proof.slice(k * 32, k * 32 + 32));\n            if (position % 2 == 0) {\n                node = sha256(0x01 + node + sibling);\n            } else {\n                node = sha256(0x01 + sibling + node);\n            }\n            position = position / 2;\n        }\n        require(position == 0, \"index out of range\");\n        require(node == this.root, \"not in the active root\");\n\n        bigint already = this.claimed[recipient];\n        require(cumulative > already, \"nothing to claim\");\n        this.claimed[recipient] = cumulative;\n        this.tokens[category].transfer(bytes(recipient), cumulative - already);\n    }\n}\n","debug":{"bytecode":"","sourceMap":"18::58:1;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;26:4:31:5;;;33::57;;;18:0:58:1;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;::::1;;;;;;;;;;;;;;;;;;;;;;","logs":[],"requires":[],"functionDebug":{"f651a7f3":{"requires":[{"ip":29,"line":28,"message":"already in sync"}],"logs":[],"sourceMap":"26:4:31:5;;;27:21:27:56;;;;;;;;;;;;;;;28:16:28:22;:25::35;;;;;;;;;:16:::1;:8::56;29:20:29:54:0;;;;;;;;;:8::55:1;;;;;;30:21:30:27:0;:8::28:1;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;26:4:31:5:0;;;;;;;;;;;;;;;;;;;::::1;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"},"edbd25fc":{"requires":[{"ip":116,"line":34,"message":"wrong token"},{"ip":121,"line":35,"message":"negative index"},{"ip":149,"line":38,"message":"bad proof length"},{"ip":153,"line":39,"message":"proof too deep"},{"ip":244,"line":50,"message":"index out of range"},{"ip":249,"line":51,"message":"not in the active root"},{"ip":284,"line":53},{"ip":285,"line":53},{"ip":286,"line":