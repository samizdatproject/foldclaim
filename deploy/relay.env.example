# /opt/foldclaim/relay.env (root:root, mode 644: no secrets here). Read by deploy/foldclaim-relay.service.
# RELAYER_WIF_FILE is set by the unit (a systemd credential); do not set it here.
NETWORK=mainnet
DEPLOY_DIR=/opt/foldclaim/deployments/mainnet
HOST=127.0.0.1
PORT=8792
ALLOWED_ORIGIN=https://samizdatproject.github.io
DAILY_CAP=12
PER_IP_PER_HOUR=3
# Behind nginx: read the client address from X-Forwarded-For (nginx overwrites it with $remote_addr).
TRUST_PROXY=1
